# ProofLens AI — Environment Configuration Template
PROJECT_NAME="ProofLens AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=false

# ==============================================================================
# Primary Database: Supabase PostgreSQL + pgvector
# ==============================================================================
# Supabase provides three connection methods in Project Settings -> Database:
#
# 1. Session Pooler (Recommended for IPv4 networks & local dev):
#    Host: aws-0-[REGION].pooler.supabase.com, Port: 5432
#    User: postgres.[PROJECT_REF]
#
# 2. Transaction Pooler (High concurrency serverless execution):
#    Host: aws-0-[REGION].pooler.supabase.com, Port: 6543
#    User: postgres.[PROJECT_REF]
#    (Note: Schema migrations require Session mode or Direct connection)
#
# 3. Direct Connection (Requires IPv6 network support):
#    Host: db.[PROJECT_REF].supabase.co, Port: 5432
#    User: postgres
#
# Replace [PROJECT_REF], [YOUR-PASSWORD], and [REGION] with your Supabase project values:
DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require"

# Synchronous Alembic Migration URL (Derived automatically from DATABASE_URL if omitted)
SYNC_DATABASE_URL="postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# SSL Mode (Always 'require' for remote Supabase connections)
DATABASE_SSL_MODE="require"

# ==============================================================================
# Storage Configuration
# ==============================================================================
# Storage backend: 'supabase' (Cloud Storage Bucket) or 'local' (Local Disk)
STORAGE_BACKEND="supabase"
STORAGE_LOCAL_ROOT="./data/storage"

# Supabase Storage Configuration (When STORAGE_BACKEND="supabase"):
# Find your project URL and service_role secret key in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="prooflens-documents"

# ==============================================================================
# Active Canonical 5-Tuple Embedding Configuration
# ==============================================================================
EMBEDDING_PROVIDER="google"
EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_VERSION="v1"
EMBEDDING_DIMENSIONS=768
EMBEDDING_TASK_TYPE="RETRIEVAL_DOCUMENT"
QUERY_TASK_TYPE="RETRIEVAL_QUERY"

# ==============================================================================
# AI & Retrieval Settings
# ==============================================================================
SIMILARITY_THRESHOLD=0.75
TOP_K_RETRIEVAL=5
GEMINI_API_KEY="your-gemini-api-key-here"
LLM_MODEL="gemini-2.5-flash"

# ==============================================================================
# Operational & Safety Limits
# ==============================================================================
MAX_DOCUMENT_SIZE_MB=50
INGESTION_LEASE_TIMEOUT_SECONDS=900
