PROJECT_NAME="ProofLens AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=false

# Database
DATABASE_URL="postgresql+asyncpg://postgres:1234@localhost:5432/prooflens"
SYNC_DATABASE_URL="postgresql://postgres:1234@localhost:5432/prooflens"

# Storage
STORAGE_LOCAL_ROOT="./data/storage"

# Active canonical 5-tuple embedding config
EMBEDDING_PROVIDER="google"
EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_VERSION="v1"
EMBEDDING_DIMENSIONS=768
EMBEDDING_TASK_TYPE="RETRIEVAL_DOCUMENT"
QUERY_TASK_TYPE="RETRIEVAL_QUERY"

# Retrieval and LLM
SIMILARITY_THRESHOLD=0.75
TOP_K_RETRIEVAL=5
GEMINI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"

# Operational limits
MAX_DOCUMENT_SIZE_MB=50
INGESTION_LEASE_TIMEOUT_SECONDS=900
